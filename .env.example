# Modelo de configuração. Copie este arquivo para ".env" e preencha os valores.
# NUNCA coloque o token de verdade neste arquivo .env.example (ele é só o modelo).

# Token do seu bot (pegue em https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=cole-seu-token-aqui

# (Opcional) ID do seu servidor. Deixe em branco para comandos globais.
# Com o ID preenchido, os comandos de barra (/) aparecem na hora no seu servidor.
GUILD_ID=
